{
  "name": "demo_login_playwright",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "help": "playwright -h",
    "test:codegen": "playwright codegen -b chromium --channel=chrome",
    "test:headed": "playwright test --headed --config=playwright.config.ts",
    "test:ui": "playwright test --ui --config=playwright.config.ts",
    "test": "playwright test --config=playwright.config.ts",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun eslint && bun prettier:check",
    "lint:fix": "bun eslint --fix && bun prettier:fix",
    "prettier:cli": "prettier \"**/*.ts\"",
    "prettier:check": "bun prettier:cli -l",
    "prettier:fix": "bun prettier:cli --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.10.2",
    "@venizia/dev-configs": "^0.0.3",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.7.0",
    "tsconfig-paths": "^4.1.0",
    "typescript": "~5.9.3"
  }
